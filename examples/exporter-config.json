{
  "schema_version": 1,
  "os": "astra",
  "backend": "dpkg_selections",
  "packages": [
    {
      "id": "java17",
      "name": "openjdk-17-jre"
    }
  ],
  "scan_interval_seconds": 300,
  "scan_timeout_seconds": 60,
