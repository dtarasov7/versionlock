[Unit]
Description=Read native package hold state into atomic cache
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart={{ package_hold_exporter_python }} {{ package_hold_exporter_binary_path }} scan --config {{ package_hold_exporter_config_path }}
TimeoutStartSec={{ package_hold_exporter_scan_timeout_seconds | int + 5 }}s
RuntimeDirectory=package-hold-exporter
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths={{ package_hold_exporter_status_path | dirname }} /run/package-hold-exporter
